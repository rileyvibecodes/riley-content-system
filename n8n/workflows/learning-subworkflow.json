{
  "name": "Riley Content System - Self-Learning",
  "nodes": [
    {
      "parameters": {
        "content": "## Self-Learning Subworkflow\n\nThis workflow processes approved content and stores it in Supabase for future retrieval.\n\n**Trigger:** Called from Approval Workflow when content is approved\n\n**Process:**\n1. Receive content items from approval\n2. Generate embeddings for each piece\n3. Store in Supabase with metadata\n4. Update voice evolution snapshot\n\n**Required Credentials:**\n- Supabase (or Supabase Postgres)\n- OpenAI (for embeddings)",
        "height": 350,
        "width": 400
      },
      "id": "sticky-info",
      "name": "Workflow Info",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-200, -100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "learn-content",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-learn",
      "name": "Webhook: Learn Content",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 200],
      "webhookId": "learn-content"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "week-date",
              "name": "week_start_date",
              "value": "={{ $json.body.week_date }}",
              "type": "string"
            },
            {
              "id": "week-topic",
              "name": "week_topic",
              "value": "={{ $json.body.topic }}",
              "type": "string"
            },
            {
              "id": "content-items",
              "name": "content_items",
              "value": "={{ $json.body.content_items }}",
              "type": "array"
            },
            {
              "id": "field-guide",
              "name": "field_guide",
              "value": "={{ $json.body.field_guide }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-data",
      "name": "Extract Input Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [200, 200]
    },
    {
      "parameters": {
        "jsCode": "// Split content items into individual outputs for processing\nconst items = $input.first().json.content_items || [];\nconst weekDate = $input.first().json.week_start_date;\nconst weekTopic = $input.first().json.week_topic;\n\nif (!items.length) {\n  return [{ json: { error: 'No content items provided' } }];\n}\n\n// Map each content item with context\nreturn items.map(item => ({\n  json: {\n    content_text: item.content || item.text,\n    platform: item.platform || 'twitter',\n    content_type: item.type || 'tweet',\n    category: item.category || null,\n    content_pillar: item.content_pillar || null,\n    scheduled_time: item.scheduled_time || null,\n    week_start_date: weekDate,\n    week_topic: weekTopic,\n    metadata: {\n      original_priority: item.priority,\n      best_time: item.best_time\n    }\n  }\n}));"
      },
      "id": "split-content",
      "name": "Split Content Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 200]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "batch-items",
      "name": "Batch Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [600, 200]
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "generate-embedding",
      "name": "Generate Embedding",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [800, 200],
      "credentials": {
        "openAiApi": {
          "id": "openai-creds",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine content with its embedding\nconst content = $input.first().json;\nconst embedding = $('Generate Embedding').first().json.embedding;\n\nreturn [{\n  json: {\n    ...content,\n    embedding: embedding\n  }\n}];"
      },
      "id": "combine-embedding",
      "name": "Combine with Embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "posted_content",
        "dataToSend": "autoMapInputData",
        "options": {}
      },
      "id": "save-to-supabase",
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 200],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-more",
              "leftValue": "={{ $('Batch Items').context.noItemsLeft }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-more-items",
      "name": "More Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1400, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-guide-content",
              "name": "content",
              "value": "={{ $('Extract Input Data').item.json.field_guide }}",
              "type": "string"
            },
            {
              "id": "fg-topic",
              "name": "topic",
              "value": "={{ $('Extract Input Data').item.json.week_topic }}",
              "type": "string"
            },
            {
              "id": "fg-week",
              "name": "week_start_date",
              "value": "={{ $('Extract Input Data').item.json.week_start_date }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prep-field-guide",
      "name": "Prepare Field Guide",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1600, 100]
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "embed-field-guide",
      "name": "Embed Field Guide",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [1800, 100],
      "credentials": {
        "openAiApi": {
          "id": "openai-creds",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine field guide with embedding\nconst fg = $input.first().json;\nconst embedding = $('Embed Field Guide').first().json.embedding;\n\nreturn [{\n  json: {\n    topic: fg.topic,\n    content: fg.content,\n    week_start_date: fg.week_start_date,\n    embedding: embedding\n  }\n}];"
      },
      "id": "combine-fg-embedding",
      "name": "Combine FG Embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 100]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "field_guides",
        "dataToSend": "autoMapInputData",
        "options": {}
      },
      "id": "save-field-guide",
      "name": "Save Field Guide",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2200, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "claude-sonnet-4-20250514",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Analyze this week's content and extract voice evolution insights. Output as JSON with:\n- tone_markers: which tone markers were most prominent\n- vocabulary_patterns: frequently used terms and phrases\n- sentence_patterns: opening hooks, transitions used\n- content_pillar_distribution: rough % of each pillar\n- voice_score: 1-10 consistency with Riley's voice\n- notable_shifts: any evolution from typical voice"
            },
            {
              "role": "user",
              "content": "=FIELD GUIDE:\n{{ $('Extract Input Data').item.json.field_guide }}\n\nCONTENT ITEMS:\n{{ JSON.stringify($('Extract Input Data').item.json.content_items, null, 2) }}\n\nAnalyze voice patterns and output JSON."
            }
          ]
        },
        "options": {
          "maxTokens": 2048,
          "temperature": 0.3
        }
      },
      "id": "analyze-voice",
      "name": "Analyze Voice Evolution",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [2400, 100],
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-creds",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse voice analysis and prepare for storage\nconst analysis = $input.first().json.message.content;\nconst weekDate = $('Extract Input Data').item.json.week_start_date;\n\nlet parsed;\ntry {\n  // Try to parse as JSON\n  const jsonMatch = analysis.match(/\\{[\\s\\S]*\\}/);\n  parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : {};\n} catch (e) {\n  parsed = { raw_analysis: analysis };\n}\n\nreturn [{\n  json: {\n    week_start_date: weekDate,\n    tone_markers: parsed.tone_markers || null,\n    vocabulary_patterns: parsed.vocabulary_patterns || null,\n    sentence_patterns: parsed.sentence_patterns || null,\n    content_pillar_distribution: parsed.content_pillar_distribution || null,\n    voice_score: parsed.voice_score || null,\n    notable_shifts: parsed.notable_shifts || null\n  }\n}];"
      },
      "id": "parse-voice-analysis",
      "name": "Parse Voice Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 100]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "voice_evolution",
        "dataToSend": "autoMapInputData",
        "options": {}
      },
      "id": "save-voice-evolution",
      "name": "Save Voice Evolution",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2800, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-creds",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"success\",\n  \"message\": \"Content learned successfully\",\n  \"week_date\": $('Extract Input Data').item.json.week_start_date,\n  \"items_stored\": $('Extract Input Data').item.json.content_items.length,\n  \"field_guide_stored\": true,\n  \"voice_evolution_recorded\": true\n} }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [3000, 100]
    },
    {
      "parameters": {
        "content": "## Embedding Note\n\nUsing OpenAI text-embedding-3-small:\n- 1536 dimensions (matches schema)\n- ~$0.02 per 1M tokens\n- Very cost effective\n\nAlternative: Use Anthropic if you don't want OpenAI dependency.",
        "height": 180,
        "width": 300
      },
      "id": "embedding-note",
      "name": "Embedding Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [700, 0]
    }
  ],
